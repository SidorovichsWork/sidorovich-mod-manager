    <string name="message_056" formatted="false">"Usa esta opción cuando ya hayas probado que el mod funciona.\n\nSe conservarán instalados:\n"</string>
    <string name="message_057" formatted="false">"\nEstos mods comparten archivos con capas anteriores. Se integran juntos para conservar el orden y el comportamiento actual.\n"</string>
    <string name="message_058" formatted="false">"\nEspacio recuperable estimado: "</string>
    <string name="message_059" formatted="false">"\nDatos compartidos que aún se necesitan: "</string>
    <string name="message_060" formatted="false">"\n\nLa app eliminará únicamente los datos que ya no se necesitan de su biblioteca y respaldos. Los archivos del juego permanecerán intactos.\n\nDespués no podrás desactivar ni desinstalar estos mods desde la app. Los mods nuevos sí podrán instalarse encima.\n\n¿Ya los probaste y quieres conservarlos instalados?"</string>
